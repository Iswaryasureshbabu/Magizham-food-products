# ===========================================
# Magizham Food Products - Backend configuration
#
# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored: never commit real credentials.
#
# Quickest way to get a working ".env":
#   $env:PGPASSWORD = "your-postgres-password"   # PowerShell
#   npm run db:bootstrap
# The bootstrap script creates the role + the database and writes this
# file for you (DATABASE_URL + a generated SESSION_SECRET).
# ===========================================

# Port the Express API listens on
PORT=5000

# PostgreSQL connection string for the magizham_db database.
# Replace YOUR_PASSWORD with the password of your PostgreSQL role.
DATABASE_URL=postgresql://magizham_app:YOUR_PASSWORD@127.0.0.1:5432/magizham_db

# Long random string used to sign session/JWT tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# Comma separated list of origins allowed to call the API (frontend dev server).
# Outside production, localhost / 127.0.0.1 / [::1] are also allowed on any
# port, so Live Server may use its fallback port (e.g. 59575) automatically.
# Production uses only the exact origins listed here.
# Use * only for quick local testing - never in production.
CORS_ORIGIN=http://localhost:5501,http://127.0.0.1:5501,http://localhost:5173,http://127.0.0.1:5173

# Optional: lifetime of the login session cookie in milliseconds (default 7 days)
SESSION_MAX_AGE=604800000

# Optional: bcrypt cost factor (default 12)
BCRYPT_ROUNDS=12

# Optional: node environment (development | production)
NODE_ENV=development

# Optional: mark the session cookie as "Secure" (requires HTTPS)
COOKIE_SECURE=false

# Optional: allow every CORS origin - local testing convenience only
CORS_ALLOW_ALL=false

# Optional: initial admin account created by `npm run admin:create`.
# Leave ADMIN_PASSWORD empty to be prompted interactively instead.
ADMIN_EMAIL=admin@magizhamfoods.com
ADMIN_PASSWORD=admin@123
ADMIN_NAME=Magizham Admin

# ===========================================
# Only needed by `npm run db:bootstrap` (the one-time setup).
# The superuser password is read from the environment, never stored here.
# ===========================================
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-postgres-superuser-password
# APP_DB=magizham_db
# APP_USER=magizham_app
