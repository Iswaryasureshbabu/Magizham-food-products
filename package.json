{
  "name": "magizham-food-products",
  "version": "1.0.0",
  "description": "Magizham Food Products - Traditional homemade spice powders, pickles, millets, snacks and ready mixes. E-commerce landing page with multilingual support (English/Tamil).",
  "main": "index.html",
  "private": true,
  "scripts": {
    "dev": "live-server . --port=5501 --open index.html",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "db:bootstrap": "node server/db/bootstrap.js",
    "db:bootstrap:sql": "psql -U postgres -d postgres -v app_password=%APP_PASSWORD% -v app_db=magizham_db -v app_user=magizham_app -f server/db/bootstrap.sql",
    "db:test": "node server/db/connection-test.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "node server/db/migrate.js --force && node server/db/seed.js",
    "admin:create": "node server/db/create-admin.js",
    "test": "node --test tests/catalogue.test.js tests/seed-logic.test.js tests/api-guards.test.js",
    "test:ui": "python tests/ui_smoke.py"
  },
  "keywords": [
    "magizham",
    "food",
    "homemade",
    "spices",
    "pickles",
    "millets",
    "tamil-nadu",
    "ecommerce"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "nodemon": "^3.1.9"
  }
}
